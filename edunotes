<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduNotes Hub - Notes Sharing Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Firebase SDK (v9 Compatibility Mode) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 antialiased flex flex-col">

    <div id="app" class="min-h-full flex flex-col flex-1">
        
        <!-- ==================== AUTHENTICATION VIEW ==================== -->
        <div id="auth-view" class="flex-1 flex items-center justify-center p-4 bg-gradient-to-br from-indigo-900 via-slate-900 to-blue-950">
            <div class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 p-8 rounded-2xl shadow-2xl text-white">
                <div class="text-center mb-8">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-indigo-600 rounded-2xl shadow-lg mb-4 text-2xl font-bold">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h1 class="text-3xl font-extrabold tracking-tight">EduNotes Hub</h1>
                    <p class="text-slate-300 text-sm mt-2">Access quality study materials or manage resources.</p>
                </div>

                <form id="login-form" onsubmit="handleLogin(event)" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-200 mb-2">Your Full Name</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-regular fa-user"></i>
                            </span>
                            <input type="text" id="username-input" required 
                                placeholder="e.g. Dhananjay Mondal or Student Name"
                                class="w-full pl-10 pr-4 py-3 bg-slate-800/60 border border-slate-600 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-white placeholder-slate-400 text-sm transition">
                        </div>
                        <p class="text-xs text-indigo-300 mt-2">
                            <i class="fa-solid fa-circle-info mr-1"></i> Entering <strong class="text-white">Dhananjay Mondal</strong> will require an admin access code.
                        </p>
                    </div>

                    <button type="submit" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-600/30 transition duration-200 flex items-center justify-center gap-2">
                        <span>Continue to Portal</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </form>

                <div class="mt-8 pt-6 border-t border-white/10 text-center text-xs text-slate-400">
                    <p>Cloud Notes Sharing Platform &bull; Powered by Firebase Realtime DB</p>
                </div>
            </div>
        </div>

        <!-- ==================== ADMIN ACCESS CODE MODAL ==================== -->
        <div id="admin-code-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-md hidden flex items-center justify-center p-4">
            <div class="w-full max-w-sm bg-white p-8 rounded-2xl shadow-2xl border border-slate-100 text-slate-800 text-center">
                <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl font-bold">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">Admin Verification</h3>
                <p class="text-xs text-slate-500 mb-6">Enter your security access code to open the admin panel.</p>

                <form onsubmit="handleAdminCodeVerify(event)" class="space-y-4">
                    <div>
                        <input type="password" id="admin-code-input" required maxlength="10" placeholder="Enter Access Code" 
                            class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-center text-lg tracking-widest font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                    <div class="flex items-center gap-2 pt-2">
                        <button type="button" onclick="cancelAdminAuth()" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl text-sm transition">
                            Cancel
                        </button>
                        <button type="submit" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-sm shadow-lg shadow-indigo-600/20 transition">
                            Verify Code
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ==================== VIEWER DASHBOARD ==================== -->
        <div id="viewer-view" class="hidden flex-1 flex flex-col bg-slate-50">
            <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <span class="font-bold text-lg text-slate-900 block leading-tight">EduNotes Hub</span>
                            <span class="text-xs text-slate-500">Student Portal</span>
                        </div>
                    </div>
                    
                    <div class="flex items-center space-x-4">
                        <div class="text-right hidden sm:block">
                            <span id="viewer-greeting" class="text-xs text-slate-500 block">Welcome, Student</span>
                            <span id="viewer-name-display" class="text-sm font-semibold text-slate-800">User</span>
                        </div>
                        <button onclick="logout()" class="px-3 py-2 text-sm font-medium text-rose-600 hover:bg-rose-50 rounded-xl transition flex items-center gap-2 border border-rose-200">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="hidden sm:inline">Logout</span>
                        </button>
                    </div>
                </div>
            </header>

            <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-8">
                <div class="bg-gradient-to-r from-indigo-600 to-blue-700 rounded-2xl p-6 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Explore Study Notes & Resources</h2>
                        <p class="text-indigo-100 mt-2 text-sm sm:text-base max-w-xl">Browse curated categories, search instantly across all uploaded notes, and download materials for your studies.</p>
                    </div>
                    <div class="w-full md:w-auto min-w-[280px]">
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <input type="text" id="search-notes" oninput="filterNotes()" 
                                placeholder="Search by title, subject..." 
                                class="w-full pl-10 pr-4 py-3 bg-white/10 backdrop-blur-md border border-white/30 rounded-xl text-white placeholder-indigo-200 focus:outline-none focus:bg-white focus:text-slate-800 focus:placeholder-slate-400 text-sm transition">
                        </div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold text-slate-800">Categories / Sections</h3>
                        <span id="notes-count-badge" class="text-xs bg-indigo-100 text-indigo-700 font-semibold px-3 py-1 rounded-full">0 notes available</span>
                    </div>
                    <div id="section-tabs" class="flex flex-wrap gap-2"></div>
                </div>

                <div class="flex-1">
                    <div id="notes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
                </div>
            </main>
        </div>

        <!-- ==================== ADMIN DASHBOARD ==================== -->
        <div id="admin-view" class="hidden flex-1 flex flex-col bg-slate-100">
            <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>
                        <div>
                            <span class="font-bold text-lg tracking-tight block leading-tight">Admin Dashboard</span>
                            <span class="text-xs text-indigo-400">Dhananjay Mondal's Portal</span>
                        </div>
                    </div>

                    <div class="flex items-center space-x-4">
                        <div class="text-right hidden sm:block">
                            <span class="text-xs text-slate-400 block">Logged in as Administrator</span>
                            <span class="text-sm font-semibold text-white">Dhananjay Mondal</span>
                        </div>
                        <button onclick="logout()" class="px-3 py-2 text-sm font-medium text-rose-300 hover:bg-rose-950/50 rounded-xl transition flex items-center gap-2 border border-rose-800">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="hidden sm:inline">Logout</span>
                        </button>
                    </div>
                </div>
            </header>

            <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-1 space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-folder-plus text-indigo-600"></i>
                            <span>Manage Sections</span>
                        </h3>
                        <form onsubmit="handleAddSection(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">New Section Name</label>
                                <input type="text" id="new-section-name" required placeholder="e.g. Artificial Intelligence" 
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                            <button type="submit" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-medium rounded-lg text-sm shadow transition">
                                Create Section
                            </button>
                        </form>

                        <div class="mt-6 pt-4 border-t border-slate-100">
                            <span class="text-xs font-semibold text-slate-400 block mb-2">Existing Sections</span>
                            <div id="admin-sections-list" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto custom-scrollbar"></div>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <h3 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-up text-indigo-600"></i>
                            <span id="note-form-title">Upload New Note</span>
                        </h3>
                        <form id="note-form" onsubmit="handleSaveNote(event)" class="space-y-4">
                            <input type="hidden" id="edit-note-id">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Note Title</label>
                                <input type="text" id="note-title" required placeholder="e.g. Lecture 1 Notes" 
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Section Category</label>
                                <select id="note-section" required 
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Description / Summary</label>
                                <textarea id="note-desc" rows="3" placeholder="Brief overview of the content..." 
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Source Type</label>
                                <div class="grid grid-cols-2 gap-2 mb-3">
                                    <button type="button" id="tab-file-btn" onclick="switchSourceType('file')" class="py-2 text-xs font-semibold rounded-lg border transition bg-indigo-600 text-white border-indigo-600">
                                        <i class="fa-solid fa-file-pdf mr-1"></i> Local PDF File
                                    </button>
                                    <button type="button" id="tab-url-btn" onclick="switchSourceType('url')" class="py-2 text-xs font-semibold rounded-lg border transition bg-slate-50 text-slate-700 border-slate-300">
                                        <i class="fa-solid fa-link mr-1"></i> External URL
                                    </button>
                                </div>
                            </div>

                            <div id="source-file-container">
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Select PDF from Device</label>
                                <input type="file" id="note-file-input" accept=".pdf" 
                                    class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer border border-slate-300 rounded-lg bg-slate-50">
                                <p class="text-[11px] text-slate-400 mt-1">Directly shares and stores PDF files securely in the cloud.</p>
                            </div>

                            <div id="source-url-container" class="hidden">
                                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">File Link (PDF/URL)</label>
                                <input type="url" id="note-link" placeholder="https://example.com/file.pdf" 
                                    class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            </div>

                            <div class="flex items-center gap-2 pt-2">
                                <button type="submit" id="note-submit-btn" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-lg text-sm shadow transition">
                                    Upload Note
                                </button>
                                <button type="button" id="note-cancel-btn" onclick="resetNoteForm()" class="hidden px-3 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium rounded-lg text-sm transition">
                                    Cancel
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col h-full">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900">Manage Uploaded Notes</h3>
                                <p class="text-xs text-slate-500">Edit or delete any resource available to viewers</p>
                            </div>
                            <span id="admin-notes-count" class="text-xs bg-slate-100 text-slate-700 font-semibold px-3 py-1 rounded-full">0 total</span>
                        </div>

                        <div class="flex-1 overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                        <th class="py-3 px-4">Title & Description</th>
                                        <th class="py-3 px-4">Section</th>
                                        <th class="py-3 px-4">Type</th>
                                        <th class="py-3 px-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="admin-notes-table" class="divide-y divide-slate-100 text-sm"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Custom Modal -->
    <div id="custom-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl border border-slate-100 text-center">
            <div id="modal-icon" class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl"></div>
            <h3 id="modal-title" class="text-lg font-bold text-slate-900 mb-2">Notice</h3>
            <p id="modal-message" class="text-sm text-slate-600 mb-6">Message goes here...</p>
            <button onclick="closeModal()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium rounded-xl text-sm transition">
                Okay
            </button>
        </div>
    </div>

    <script>
        // Integrated Firebase Credentials
        const firebaseConfig = {
            apiKey: "AIzaSyB1l2k3wtBqaSkiV3qV31SFhejCJNP4CiA",
            authDomain: "study-34626.firebaseapp.com",
            databaseURL: "https://study-34626-default-rtdb.firebaseio.com",
            projectId: "study-34626",
            storageBucket: "study-34626.firebasestorage.app",
            messagingSenderId: "1007416063405",
            appId: "1:1007416063405:web:ca40587fe1005bdd97dd24",
            measurementId: "G-5208QRQLTV"
        };

        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        // Default Data Fallbacks
        const DEFAULT_SECTIONS = ["Mathematics", "Physics", "Chemistry", "Computer Science", "General Studies"];

        // Global State
        let currentUser = localStorage.getItem('edunotes_current_user') || null;
        let isAdminAuthenticated = localStorage.getItem('edunotes_is_admin') === 'true';
        let sections = [];
        let notes = [];
        let currentSectionFilter = 'All';
        let uploadSourceType = 'file';

        // Connect Realtime Sync with Firebase Database
        window.addEventListener('DOMContentLoaded', () => {
            listenToCloudData();
            checkAuthState();
        });

        function listenToCloudData() {
            // Realtime Sync for Sections
            db.ref('sections').on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    sections = Array.isArray(data) ? data : Object.values(data);
                } else {
                    db.ref('sections').set(DEFAULT_SECTIONS);
                    sections = DEFAULT_SECTIONS;
                }
                updateUI();
            });

            // Realtime Sync for Notes
            db.ref('notes').on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    notes = Object.keys(data).map(key => ({ id: key, ...data[key] }));
                } else {
                    notes = [];
                }
                updateUI();
            });
        }

        function updateUI() {
            if (currentUser) {
                if (currentUser.trim().toLowerCase() === "dhananjay mondal" && isAdminAuthenticated) {
                    initAdminDashboard();
                } else {
                    initViewerDashboard();
                }
            }
        }

        // Custom Modal Alert
        function showAlert(title, message, type = 'info') {
            const modal = document.getElementById('custom-modal');
            const modalTitle = document.getElementById('modal-title');
            const modalMsg = document.getElementById('modal-message');
            const modalIcon = document.getElementById('modal-icon');

            modalTitle.textContent = title;
            modalMsg.textContent = message;

            if (type === 'success') {
                modalIcon.className = "w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl bg-emerald-100 text-emerald-600";
                modalIcon.innerHTML = '<i class="fa-solid fa-check"></i>';
            } else if (type === 'error') {
                modalIcon.className = "w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl bg-rose-100 text-rose-600";
                modalIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            } else {
                modalIcon.className = "w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 text-xl bg-indigo-100 text-indigo-600";
                modalIcon.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        // Login Handler
        function handleLogin(e) {
            e.preventDefault();
            const nameInput = document.getElementById('username-input').value.trim();
            if (!nameInput) return;

            currentUser = nameInput;

            if (currentUser.trim().toLowerCase() === "dhananjay mondal") {
                if (isAdminAuthenticated) {
                    saveSessionState();
                    checkAuthState();
                } else {
                    document.getElementById('admin-code-input').value = '';
                    document.getElementById('admin-code-modal').classList.remove('hidden');
                    document.getElementById('admin-code-input').focus();
                }
            } else {
                isAdminAuthenticated = false;
                saveSessionState();
                checkAuthState();
            }
        }

        function handleAdminCodeVerify(e) {
            e.preventDefault();
            const codeInput = document.getElementById('admin-code-input').value.trim();

            if (codeInput === "2011") {
                isAdminAuthenticated = true;
                document.getElementById('admin-code-modal').classList.add('hidden');
                saveSessionState();
                checkAuthState();
                showAlert("Access Granted", "Welcome back, Dhananjay Mondal!", "success");
            } else {
                showAlert("Invalid Code", "The access code you entered is incorrect. Opening normal student portal.", "error");
                isAdminAuthenticated = false;
                document.getElementById('admin-code-modal').classList.add('hidden');
                saveSessionState();
                checkAuthState();
            }
        }

        function cancelAdminAuth() {
            document.getElementById('admin-code-modal').classList.add('hidden');
            currentUser = null;
            isAdminAuthenticated = false;
            saveSessionState();
            checkAuthState();
        }

        function logout() {
            currentUser = null;
            isAdminAuthenticated = false;
            localStorage.removeItem('edunotes_current_user');
            localStorage.removeItem('edunotes_is_admin');
            document.getElementById('username-input').value = '';
            checkAuthState();
        }

        function saveSessionState() {
            if (currentUser) {
                localStorage.setItem('edunotes_current_user', currentUser);
            } else {
                localStorage.removeItem('edunotes_current_user');
            }
            localStorage.setItem('edunotes_is_admin', isAdminAuthenticated);
        }

        function checkAuthState() {
            const authView = document.getElementById('auth-view');
            const viewerView = document.getElementById('viewer-view');
            const adminView = document.getElementById('admin-view');

            if (!currentUser) {
                authView.classList.remove('hidden');
                viewerView.classList.add('hidden');
                adminView.classList.add('hidden');
                return;
            }

            authView.classList.add('hidden');

            if (currentUser.trim().toLowerCase() === "dhananjay mondal" && isAdminAuthenticated) {
                adminView.classList.remove('hidden');
                viewerView.classList.add('hidden');
                initAdminDashboard();
            } else {
                viewerView.classList.remove('hidden');
                adminView.classList.add('hidden');
                initViewerDashboard();
            }
        }

        /* ==================== VIEWER FUNCTIONS ==================== */
        function initViewerDashboard() {
            document.getElementById('viewer-name-display').textContent = currentUser;
            renderViewerSectionTabs();
            filterNotes();
        }

        function renderViewerSectionTabs() {
            const container = document.getElementById('section-tabs');
            let html = `
                <button onclick="setSectionFilter('All')" class="px-4 py-2 rounded-xl text-xs font-semibold transition ${currentSectionFilter === 'All' ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/20' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}">
                    All Sections
                </button>
            `;
            sections.forEach(sec => {
                const isActive = currentSectionFilter === sec;
                html += `
                    <button onclick="setSectionFilter('${sec}')" class="px-4 py-2 rounded-xl text-xs font-semibold transition ${isActive ? 'bg-indigo-600 text-white shadow-md shadow-indigo-600/20' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}">
                        ${sec}
                    </button>
                `;
            });
            container.innerHTML = html;
        }

        function setSectionFilter(sec) {
            currentSectionFilter = sec;
            renderViewerSectionTabs();
            filterNotes();
        }

        function filterNotes() {
            const searchTerm = document.getElementById('search-notes').value.toLowerCase();
            const grid = document.getElementById('notes-grid');
            const countBadge = document.getElementById('notes-count-badge');

            const filtered = notes.filter(note => {
                const matchesSection = (currentSectionFilter === 'All' || note.section === currentSectionFilter);
                const matchesSearch = note.title.toLowerCase().includes(searchTerm) || 
                                      note.desc.toLowerCase().includes(searchTerm) || 
                                      note.section.toLowerCase().includes(searchTerm);
                return matchesSection && matchesSearch;
            });

            countBadge.textContent = `${filtered.length} notes available`;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-16 text-center bg-white rounded-2xl border border-slate-200">
                        <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <h4 class="text-base font-bold text-slate-700">No notes found</h4>
                        <p class="text-xs text-slate-500 mt-1">Try adjusting your search query or select another section.</p>
                    </div>
                `;
                return;
            }

            let html = '';
            filtered.forEach(note => {
                const badgeLabel = note.sourceType === 'file' ? 'Local PDF File' : 'External Link';
                const badgeColor = note.sourceType === 'file' ? 'bg-emerald-50 text-emerald-700' : 'bg-blue-50 text-blue-700';
                
                html += `
                    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-semibold bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full">${note.section}</span>
                                <span class="text-xs ${badgeColor} px-2 py-0.5 rounded font-medium">${badgeLabel}</span>
                            </div>
                            <h4 class="text-base font-bold text-slate-900 mb-2">${escapeHTML(note.title)}</h4>
                            <p class="text-xs text-slate-600 line-clamp-3 mb-4 leading-relaxed">${escapeHTML(note.desc || 'No description provided.')}</p>
                        </div>
                        <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-[11px] text-slate-400"><i class="fa-regular fa-calendar mr-1"></i>${note.date}</span>
                            <a href="${note.link}" ${note.sourceType === 'file' ? `download="${note.fileName || 'note.pdf'}"` : 'target="_blank" rel="noopener noreferrer"'} 
                                class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium rounded-xl transition shadow-sm">
                                <i class="fa-solid ${note.sourceType === 'file' ? 'fa-download' : 'fa-arrow-up-right-from-square'}"></i>
                                <span>${note.sourceType === 'file' ? 'Download PDF' : 'Open Link'}</span>
                            </a>
                        </div>
                    </div>
                `;
            });

            grid.innerHTML = html;
        }

        /* ==================== ADMIN FUNCTIONS ==================== */
        function initAdminDashboard() {
            renderAdminSections();
            renderAdminSectionDropdown();
            renderAdminNotesTable();
        }

        function switchSourceType(type) {
            uploadSourceType = type;
            const fileBtn = document.getElementById('tab-file-btn');
            const urlBtn = document.getElementById('tab-url-btn');
            const fileContainer = document.getElementById('source-file-container');
            const urlContainer = document.getElementById('source-url-container');
            const fileInput = document.getElementById('note-file-input');
            const urlInput = document.getElementById('note-link');

            if (type === 'file') {
                fileBtn.className = "py-2 text-xs font-semibold rounded-lg border transition bg-indigo-600 text-white border-indigo-600";
                urlBtn.className = "py-2 text-xs font-semibold rounded-lg border transition bg-slate-50 text-slate-700 border-slate-300";
                fileContainer.classList.remove('hidden');
                urlContainer.classList.add('hidden');
                fileInput.required = true;
                urlInput.required = false;
            } else {
                urlBtn.className = "py-2 text-xs font-semibold rounded-lg border transition bg-indigo-600 text-white border-indigo-600";
                fileBtn.className = "py-2 text-xs font-semibold rounded-lg border transition bg-slate-50 text-slate-700 border-slate-300";
                urlContainer.classList.remove('hidden');
                fileContainer.classList.add('hidden');
                urlInput.required = true;
                fileInput.required = false;
            }
        }

        function renderAdminSections() {
            const container = document.getElementById('admin-sections-list');
            let html = '';
            sections.forEach(sec => {
                html += `
                    <div class="inline-flex items-center gap-2 bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium">
                        <span>${sec}</span>
                        ${sections.length > 1 ? `<button type="button" onclick="handleDeleteSection('${sec}')" class="text-slate-400 hover:text-rose-600 transition"><i class="fa-solid fa-xmark"></i></button>` : ''}
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function renderAdminSectionDropdown() {
            const select = document.getElementById('note-section');
            let html = '';
            sections.forEach(sec => {
                html += `<option value="${sec}">${sec}</option>`;
            });
            select.innerHTML = html;
        }

        function handleAddSection(e) {
            e.preventDefault();
            const input = document.getElementById('new-section-name');
            const secName = input.value.trim();

            if (!secName) return;

            if (sections.includes(secName)) {
                showAlert("Duplicate Section", "This section category already exists.", "error");
                return;
            }

            const updatedSections = [...sections, secName];
            db.ref('sections').set(updatedSections).then(() => {
                input.value = '';
                showAlert("Success", `Section "${secName}" successfully created.`, "success");
            });
        }

        function handleDeleteSection(secName) {
            if (sections.length <= 1) {
                showAlert("Action Denied", "You must keep at least one active section.", "error");
                return;
            }

            const hasNotes = notes.some(n => n.section === secName);
            if (hasNotes) {
                showAlert("Section In Use", "Cannot delete a section that currently contains notes. Please reassign or delete the notes first.", "error");
                return;
            }

            const updatedSections = sections.filter(s => s !== secName);
            db.ref('sections').set(updatedSections).then(() => {
                showAlert("Deleted", `Section "${secName}" was removed.`, "success");
            });
        }

        function handleSaveNote(e) {
            e.preventDefault();
            const editId = document.getElementById('edit-note-id').value;
            const title = document.getElementById('note-title').value.trim();
            const section = document.getElementById('note-section').value;
            const desc = document.getElementById('note-desc').value.trim();

            if (!title || !section) return;

            if (uploadSourceType === 'file') {
                const fileInput = document.getElementById('note-file-input');
                const file = fileInput.files[0];

                if (!file && !editId) {
                    showAlert("File Missing", "Please select a PDF file from your device.", "error");
                    return;
                }

                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        const base64Data = event.target.result;
                        saveNoteToCloud(editId, title, section, desc, base64Data, 'file', file.name);
                    };
                    reader.onerror = function() {
                        showAlert("Error", "Failed to read the selected file.", "error");
                    };
                    reader.readAsDataURL(file);
                } else {
                    const existingNote = notes.find(n => n.id === editId);
                    saveNoteToCloud(editId, title, section, desc, existingNote.link, existingNote.sourceType, existingNote.fileName);
                }
            } else {
                const link = document.getElementById('note-link').value.trim();
                if (!link) {
                    showAlert("URL Missing", "Please enter a valid file URL.", "error");
                    return;
                }
                saveNoteToCloud(editId, title, section, desc, link, 'url', '');
            }
        }

        function saveNoteToCloud(editId, title, section, desc, link, sourceType, fileName) {
            const payload = {
                title,
                section,
                desc,
                link,
                sourceType,
                fileName,
                date: new Date().toISOString().split('T')[0]
            };

            if (editId) {
                db.ref('notes/' + editId).update(payload).then(() => {
                    showAlert("Success", "Note updated successfully across all devices.", "success");
                    resetNoteForm();
                });
            } else {
                const newNoteRef = db.ref('notes').push();
                newNoteRef.set(payload).then(() => {
                    showAlert("Success", "New note published to all connected devices.", "success");
                    resetNoteForm();
                });
            }
        }

        function renderAdminNotesTable() {
            const tbody = document.getElementById('admin-notes-table');
            const countSpan = document.getElementById('admin-notes-count');
            countSpan.textContent = `${notes.length} total`;

            if (notes.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="py-8 text-center text-slate-400 text-xs">No notes uploaded yet.</td>
                    </tr>
                `;
                return;
            }

            let html = '';
            notes.forEach(note => {
                const typeBadge = note.sourceType === 'file' 
                    ? '<span class="text-[11px] font-medium bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full"><i class="fa-solid fa-file-pdf mr-1"></i>Cloud PDF</span>' 
                    : '<span class="text-[11px] font-medium bg-blue-50 text-blue-700 px-2.5 py-1 rounded-full"><i class="fa-solid fa-link mr-1"></i>URL Link</span>';

                html += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 px-4">
                            <span class="font-semibold text-slate-900 block">${escapeHTML(note.title)}</span>
                            <span class="text-xs text-slate-500 line-clamp-1">${escapeHTML(note.desc || 'No description')}</span>
                        </td>
                        <td class="py-4 px-4 whitespace-nowrap">
                            <span class="text-xs font-medium bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-full">${note.section}</span>
                        </td>
                        <td class="py-4 px-4 whitespace-nowrap">
                            ${typeBadge}
                        </td>
                        <td class="py-4 px-4 whitespace-nowrap text-right space-x-2">
                            <button type="button" onclick="editNote('${note.id}')" class="px-2.5 py-1.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 rounded-lg text-xs font-medium transition" title="Edit Note">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button type="button" onclick="deleteNote('${note.id}')" class="px-2.5 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg text-xs font-medium transition" title="Delete Note">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        function editNote(id) {
            const note = notes.find(n => n.id === id);
            if (!note) return;

            document.getElementById('edit-note-id').value = note.id;
            document.getElementById('note-title').value = note.title;
            document.getElementById('note-section').value = note.section;
            document.getElementById('note-desc').value = note.desc;

            if (note.sourceType === 'file') {
                switchSourceType('file');
            } else {
                switchSourceType('url');
                document.getElementById('note-link').value = note.link;
            }

            document.getElementById('note-form-title').textContent = "Edit Note";
            document.getElementById('note-submit-btn').textContent = "Update Note";
            document.getElementById('note-cancel-btn').classList.remove('hidden');

            document.getElementById('note-form').scrollIntoView({ behavior: 'smooth' });
        }

        function resetNoteForm() {
            document.getElementById('note-form').reset();
            document.getElementById('edit-note-id').value = '';
            document.getElementById('note-form-title').textContent = "Upload New Note";
            document.getElementById('note-submit-btn').textContent = "Upload Note";
            document.getElementById('note-cancel-btn').classList.add('hidden');
            switchSourceType('file');
        }

        function deleteNote(id) {
            if (confirm("Are you sure you want to delete this note from the cloud?")) {
                db.ref('notes/' + id).remove().then(() => {
                    showAlert("Deleted", "Note removed permanently across all devices.", "success");
                });
            }
        }

        function escapeHTML(str) {
            return str ? str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            ) : '';
        }
    </script>
</body>
</html>
